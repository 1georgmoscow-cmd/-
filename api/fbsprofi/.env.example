; Скопируйте в .env (файл .env в git не попадает) и при необходимости поменяйте.

; Базовый адрес сайта. Пусто = тот же хост, где работает API: https://{SERVER_NAME}
FBSPROFI_BASE_URL=

; Куда отправляется форма входа (login=...&password=...)
FBSPROFI_LOGIN_PATH=/auth/submit_log.php
FBSPROFI_LOGIN_FIELD=login
FBSPROFI_PASSWORD_FIELD=password

; Префикс адреса, куда сайт перенаправляет после входа = кабинет.
; Поправьте под реальные адреса кабинетов на сайте.
FBSPROFI_CABINETS="/owner=owner,/accounting=accounting,/client=client"

; Время жизни выданного токена (сек) и таймаут запроса к сайту (сек)
FBSPROFI_SESSION_TTL=86400
FBSPROFI_TIMEOUT=15
